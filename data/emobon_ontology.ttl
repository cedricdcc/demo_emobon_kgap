PREFIX dc: <http://purl.org/dc/elements/1.1/>


<https://data.emobon.embrc.eu/ns/core#hard>
        rdf:type               skos:Concept ;
        dc:date                "2024-08-30" ;
        dc:identifier          "Hard" ;
        skos:prefLabel         "Hard"@en ;
        skos:definition        "Hard sample type"@en ;
        skos:altLabel          "hard"
        .

<https://data.emobon.embrc.eu/ns/core#soil>
        rdf:type               skos:Concept ;
        dc:date                "2024-08-30" ;
        dc:identifier          "Soil" ;
        skos:prefLabel         "Soil"@en ;
        skos:definition        "Soil sample type"@en ;
        skos:altLabel          "soil"
        .

<https://data.emobon.embrc.eu/ns/core#water>
        rdf:type               skos:Concept ;
        dc:date                "2024-08-30" ;
        dc:identifier          "Water" ;
        skos:prefLabel         "Water"@en ;
        skos:definition        "Water sample type"@en ;
        skos:altLabel          "water"
        .

<https://data.emobon.embrc.eu/ns/core#blankSample>
        rdf:type               skos:Concept ;
        dc:date                "2025-03-10" ;
        dc:identifier          "Blank Sample" ;
        skos:prefLabel         "Blank Sample"@en ;
        skos:definition        "Blank sample"@en ;
        skos:altLabel          "blankSample"
        .

<https://data.emobon.embrc.eu/ns/core#fieldSample>
        rdf:type               skos:Concept ;
        dc:date                "2025-03-10" ;
        dc:identifier          "Field Sample" ;
        skos:prefLabel         "Field Sample"@en ;
        skos:definition        "Field sample"@en ;
        skos:altLabel          "fieldSample"
        .

