
PREFIX prod: <https://data.emobon.embrc.eu/ns/product#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX emobon: <https://data.emobon.embrc.eu/ns/core#>
PREFIX sampl: <https://data.emobon.embrc.eu/ns/sampling#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ontotext.com/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT
  ?sample
  ?observatory
  ?event
  
  ?observations
  
  ?label_sediment_temp
  ?result_sediment_temp
  ?value_sediment_temp
  ?label_nitrite
  ?result_nitrite
  ?value_nitrite
  ?label_turbidity
  ?result_turbidity
  ?value_turbidity
  ?taxonannotation
  ?taxonid
    ?sname
  ?rank
  ?lsuval
  ?ssuval
WHERE {
  ?sample a sosa:Sample .
  # link event
  ?sample sosa:isResultOf ?event .
  # link observatory
  ?event sampl:linkedToObservatory ?observatory .
  # Optional filters
  # name of observatory
  # depth filter
  
  ?event prov:startedAtTime ?datetime_begin . 
  
  # dateTime event
  FILTER(?datetime_begin >= "2025-09-24T17:01:35Z"^^xsd:date) .
  FILTER(?datetime_begin <= "2025-12-08T08:34:03Z"^^xsd:date) .
  # linking between taxon annotations and sample
  ?taxonannotation a prod:TaxonomicAnnotation .
  ?taxonannotation prod:ofSample ?sample .
  ?taxonannotation dct:identifier ?taxonid .
      
  ?taxonid dct:scientificName ?sname .
  ?sname onto:fts ("Levilinea_saccharolytica~5") .
  ?taxonid dct:taxonRank ?rank .
  ?rank onto:fts ("genus~5") .
  OPTIONAL {
    ?taxonannotation prod:lsuRNA ?lsuval .
    FILTER(?lsuval >= 17.008431834407233) . 
  }
  OPTIONAL {
    ?taxonannotation prod:ssuRNA ?ssuval .
    FILTER(?ssuval >= 17.008431834407233) .  
  }
  FILTER(BOUND(?lsuval) || BOUND(?ssuval))
  ?observations a sosa:Observation .
  ?observations sosa:hasFeatureOfInterest ?sample .
    
  ?observations sosa:observedProperty ?sediment_temp .
  ?sediment_temp rdfs:label ?label_sediment_temp .
  ?label_sediment_temp onto:fts "sediment_temp~5" .
  ?observations sosa:hasResult ?result_sediment_temp .
  ?result_sediment_temp qudt:numericValue ?value_sediment_temp .
  FILTER(?value_sediment_temp >= 48.46470631611639)
  ?observations sosa:observedProperty ?nitrite .
  ?nitrite rdfs:label ?label_nitrite .
  ?label_nitrite onto:fts "nitrite~5" .
  ?observations sosa:hasResult ?result_nitrite .
  ?result_nitrite qudt:numericValue ?value_nitrite .
  FILTER(?value_nitrite < 83.56518534061796)
  ?observations sosa:observedProperty ?turbidity .
  ?turbidity rdfs:label ?label_turbidity .
  ?label_turbidity onto:fts "turbidity~5" .
  ?observations sosa:hasResult ?result_turbidity .
  ?result_turbidity qudt:numericValue ?value_turbidity .
  FILTER(?value_turbidity <= 0.8122757601335628)
}