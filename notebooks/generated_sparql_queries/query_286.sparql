
PREFIX prod: <https://data.emobon.embrc.eu/ns/product#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX emobon: <https://data.emobon.embrc.eu/ns/core#>
PREFIX sampl: <https://data.emobon.embrc.eu/ns/sampling#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ontotext.com/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT
  ?sample
  ?observatory
  ?event
  
  ?observations
  
  ?label_pigments
  ?result_pigments
  ?value_pigments
  ?label_density
  ?result_density
  ?value_density
  ?label_redox_potential
  ?result_redox_potential
  ?value_redox_potential
WHERE {
  ?sample a sosa:Sample .
  # link event
  ?sample sosa:isResultOf ?event .
  # link observatory
  ?event sampl:linkedToObservatory ?observatory .
  # Optional filters
  # name of observatory
  
  ?observatory emobon:observatoryId ?observatory_id .
  ?observatory_id onto:fts ("RFormosa~5 OSD74~5 ROSKOGO~5") .# depth filter
  
  ?observatory emobon:waterColumnDepth/qudt:numericValue ?depth_value .
  FILTER(?depth_value < 404) .
  # Marine Region (ID)
  ?observatory emobon:marineRegion ?mrgid . 
  FILTER regex(str(?mrgid), "http://marineregions.org/mrgid/25242") .
  # marineregion name
  ?observatory emobon:marineRegionName ?mrgn . 
  ?mrgn onto:fts ("Mediterranean Sea - Eastern Basin~5") .
  ?event prov:startedAtTime ?datetime_begin . 
  
  # dateTime event
  FILTER(?datetime_begin >= "2023-09-21T21:18:35Z"^^xsd:date) .
  FILTER(?datetime_begin <= "2024-08-16T15:10:05Z"^^xsd:date) .
  ?observations a sosa:Observation .
  ?observations sosa:hasFeatureOfInterest ?sample .
    
  ?observations sosa:observedProperty ?pigments .
  ?pigments rdfs:label ?label_pigments .
  ?label_pigments onto:fts "pigments~5" .
  ?observations sosa:hasResult ?result_pigments .
  ?result_pigments qudt:numericValue ?value_pigments .
  FILTER(?value_pigments < 18)
  ?observations sosa:observedProperty ?density .
  ?density rdfs:label ?label_density .
  ?label_density onto:fts "density~5" .
  ?observations sosa:hasResult ?result_density .
  ?result_density qudt:numericValue ?value_density .
  FILTER(?value_density > 37)
  ?observations sosa:observedProperty ?redox_potential .
  ?redox_potential rdfs:label ?label_redox_potential .
  ?label_redox_potential onto:fts "redox_potential~5" .
  ?observations sosa:hasResult ?result_redox_potential .
  ?result_redox_potential qudt:numericValue ?value_redox_potential .
  FILTER(?value_redox_potential <= 34)
}